{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:preview": "PORT=4175 BASE_PATH=/ pnpm --filter @workspace/luxxy-motors run dev:preview",
    "start": "NODE_ENV=production FRONTEND_DIST_DIR=artifacts/luxxy-motors/dist/public node --env-file-if-exists=.env artifacts/api-server/dist/index.mjs",
    "dev:api": "PORT=8080 node --env-file-if-exists=.env artifacts/api-server/dist/index.mjs",
    "build:cazoo-demo": "pnpm --filter @workspace/luxxy-motors build:cazoo-demo && pnpm --filter @workspace/api-server build:cazoo-demo",
    "start:cazoo-demo": "node artifacts/api-server/dist-cazoo/server.mjs"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@11.19.0"
}
