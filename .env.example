# Copy to .env at the repository root. Never commit real credentials.
# Node 24+, pnpm 11.19.0. No platform-specific secrets are required.
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DEVELOPMENT_DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_SITE_URL=http://127.0.0.1:4175
PUBLIC_SITE_BASE_PATH=
BASE_PATH=/

# Keys from your independently owned Clerk application (same app on both sides).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Direct Clerk connection is the default. Only enable after configuring its proxy.
CLERK_PROXY_ENABLED=false
VITE_CLERK_PROXY_URL=
PORTAL_STAFF_EMAILS=
# Optional server-to-server staff integration token. Never put this in VITE_*.
PORTAL_API_TOKEN=

# Direct Resend account and verified sender; missing credentials fail closed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEALER_NOTIFICATION_EMAIL=

# Each dealership has its own database and stock-feed credentials.
STOCK_DEALER_ID=your-dealership
STOCK_RETAILER_ID=
STOCK_IMPORT_SECRET=
STOCK_MAX_AGE_HOURS=24
STOCK_MAX_DROP_PERCENT=30
STOCK_MAX_PRICE_CHANGE_PERCENT=50
STOCK_MIN_PRICE=500
STOCK_MISSING_HIDE_THRESHOLD=2
STOCK_SUPPORTED_SCHEMA_VERSION=1
DEALER_TIMEZONE=Europe/London
# Payments remain disabled until a real payment provider is integrated.
RESERVATION_PAYMENT_MODE=disabled
# Optional comma-separated extra image hosts for vehicle PDF generation.
VEHICLE_PDF_IMAGE_HOSTS=

# Private email and payment integrations (keys are entered in owner Settings).
# Production requires a persistent private directory and a 32-byte encryption key.
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_PRIVATE_DIR=
RESEND_ENABLED=false
RESEND_REPLY_TO_EMAIL=
# Import feed alerts are shown if no complete successful snapshot arrives in this interval.
STOCK_STALE_AFTER_HOURS=36

# One active marketplace. Existing deployments default to autotrader.
STOCK_PLATFORM=autotrader
STOCK_SOURCE_URL=
# Explicit Clerk user IDs of platform operators; dealership owners are not platform admins.
PLATFORM_ADMIN_USER_IDS=

# Shared application (leave off on existing single-dealer deployments).
MULTI_TENANT_ENABLED=false
VITE_MULTI_TENANT_ENABLED=false
# Exact hostnames, without scheme. Domains must be registered/verified in the database.
PLATFORM_ADMIN_HOST=
STOCK_IMPORT_API_HOST=

# Operator-owned demo subdomains. Configure wildcard DNS/TLS and Clerk before enabling.
# Example for the selected test domain: demo.luxxyexmaplenumber2.uk
DEMO_BASE_DOMAIN=
DEMO_DOMAINS_READY=false
# Verified Resend sending domain (not an inbox), separate restricted API key.
DEMO_EMAIL_DOMAIN=
DEMO_RESEND_API_KEY=
DEMO_RESEND_VERIFIED=false
# Explicit comma-separated operator test addresses. Never customer mailing lists.
DEMO_EMAIL_RECIPIENTS=

# Optional server-only key with Resend sent-email read permission for automated demo delivery checks.
# Never give this provider key to Grok; a sending-only key cannot confirm delivery.
DEMO_RESEND_STATUS_API_KEY=

# Optional platform-admin domain automation. Disabled until scoped provider access is supplied.
# Keep these provider keys only in the server's secure environment, never VITE_* or chat.
DOMAIN_AUTOMATION_ENABLED=false
CLOUDFLARE_DNS_API_TOKEN=
RENDER_DOMAINS_API_KEY=
DOMAIN_AUTOMATION_RENDER_SERVICE_ID=
# The shared web service hostname only, without https:// or a path.
DOMAIN_AUTOMATION_RENDER_TARGET=
# Operator Cloudflare account ID (32 hexadecimal characters). New active zones in this
# account can be connected by entering the domain; the token must cover those zones.
DOMAIN_AUTOMATION_CLOUDFLARE_ACCOUNT_ID=
# Optional narrower allowlist of active zone names. Required when no account ID is set.
DOMAIN_AUTOMATION_ZONES=
