{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "PHASE2A_SCHEMA_MODE=final drizzle-kit generate --config ./drizzle.config.ts",
    "push": "PHASE2A_SCHEMA_MODE=final drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "PHASE2A_SCHEMA_MODE=final drizzle-kit push --force --config ./drizzle.config.ts",
    "push:phase2a-parent-keys": "PHASE2A_SCHEMA_MODE=parent-keys drizzle-kit push --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
