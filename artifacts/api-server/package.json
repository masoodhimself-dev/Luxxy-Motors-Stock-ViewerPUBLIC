{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:safety && pnpm run test:stock && pnpm run test:sales && pnpm run test:leads && pnpm run test:portal && pnpm run test:settings",
    "test:portal": "node ./test-build.mjs src/portal.integration.test.ts && node --enable-source-maps --test ./dist-test/portal.integration.test.mjs",
    "test:stock": "node ./test-build.mjs src/stock.integration.test.ts && node --enable-source-maps --test ./dist-test/stock.integration.test.mjs",
    "test:sales": "node ./test-build.mjs src/sales.integration.test.ts && node --enable-source-maps --test ./dist-test/sales.integration.test.mjs",
    "test:leads": "node ./test-build.mjs src/leads.integration.test.ts && node --enable-source-maps --test ./dist-test/leads.integration.test.mjs",
    "test:migrations": "node ./test-build.mjs src/migrations.integration.test.ts && node --enable-source-maps --test ./dist-test/migrations.integration.test.mjs",
    "test:safety": "node ./test-build.mjs src/test/database-guard.test.ts && node --enable-source-maps --test ./dist-test/database-guard.test.mjs",
    "test:settings": "node ./test-build.mjs src/settings-content.test.ts && node --enable-source-maps --test ./dist-test/settings-content.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.64",
    "@clerk/shared": "^4.30.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/vehicle-meta": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
